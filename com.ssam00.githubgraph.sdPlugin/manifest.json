{
	"Name": "Github Graph",
	"Version": "0.1.0.0",
	"Author": "Samuel Alvarez",
	"UUID": "com.ssam00.githubgraph",
	"Actions": [{
			"Name": "Counter",
			"UUID": "com.ssam00.githubgraph.increment",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Displays a count, which increments by one on press.",
			"PropertyInspectorPath": "ui/increment-counter.html",
			"Controllers": ["Keypad"],
			"States": [{
					"Image": "imgs/actions/counter/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Heatmap Week",
			"UUID": "com.ssam00.githubgraph.week",
			"Icon": "imgs/actions/counter/icon",
			"Tooltip": "Shows your Github commits for the last 7 days",
			"PropertyInspectorPath": "ui/heatmap-week.html",
			"Controllers": ["Keypad"],
			"States": [{
				"Image": "imgs/actions/counter/key"
			}]
		}
	],
	"Category": "Github Graph",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Visualize your Github commit activity with heatmap graphs",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "--inspect=127.0.0.1:12345"
	}
}